-
-    # Authentication flow
-    authr = Authenticator()
-    for req_data in authr:
-        writer.write(req_data)
-        await writer.drain()
-        b = await reader.read(1024)
-        if not b:
-            raise EOFError("Socket closed before authentication")
-        authr.feed(b)
-
-    writer.write(BEGIN)
-    await writer.drain()
-    # Authentication finished
-
-    conn = DBusConnection(reader, writer)
