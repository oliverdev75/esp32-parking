-MODULE_TEMPLATE = '''\
-"""Auto-generated DBus bindings
-
-Generated by jeepney version {version}
-
-Object path: {path}
-Bus name   : {bus_name}
-"""
-
-from jeepney.wrappers import MessageGenerator, new_method_call
-
