-    @RequiredKeys(rewriter_keys['kwargs'])
-    def process_kwargs(self, cmd):
-        mlog.log('Processing function type', mlog.bold(cmd['function']), 'with id', mlog.cyan("'" + cmd['id'] + "'"))
-        if cmd['function'] not in rewriter_func_kwargs:
