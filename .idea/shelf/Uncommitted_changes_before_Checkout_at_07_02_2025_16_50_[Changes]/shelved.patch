-class ScalarAttributeImpl(AttributeImpl):
-    """represents a scalar value-holding InstrumentedAttribute."""
-
-    default_accepts_scalar_loader = True
-    uses_objects = False
-    supports_population = True
-    collection = False
-    dynamic = False
