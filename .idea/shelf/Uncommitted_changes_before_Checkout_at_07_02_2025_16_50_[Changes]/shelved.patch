-    def fire_replace_event(
-        self,
-        state: InstanceState[Any],
-        dict_: _InstanceDict,
-        value: _T,
-        previous: Any,
-        initiator: Optional[AttributeEventToken],
-    ) -> _T:
-        for fn in self.dispatch.set:
-            value = fn(
-                state, value, previous, initiator or self._replace_token
-            )
-        return value
