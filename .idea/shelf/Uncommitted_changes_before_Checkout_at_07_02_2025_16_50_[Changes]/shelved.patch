-    def set(
-        self,
-        state: InstanceState[Any],
-        dict_: Dict[str, Any],
-        value: Any,
-        initiator: Optional[AttributeEventToken] = None,
-        passive: PassiveFlag = PASSIVE_OFF,
-        check_old: Optional[object] = None,
-        pop: bool = False,
