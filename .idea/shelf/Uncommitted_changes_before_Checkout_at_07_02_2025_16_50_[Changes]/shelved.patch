-    def fire_remove_event(
-        self,
-        state: InstanceState[Any],
-        dict_: _InstanceDict,
-        value: Any,
-        initiator: Optional[AttributeEventToken],
-    ) -> None:
-        for fn in self.dispatch.remove:
-            fn(state, value, initiator or self._remove_token)
